<div style="display: flex; justify-content: center; gap: 0.5rem; margin-bottom: 2rem; flex-wrap: wrap;">
  <a href="{{ '/publications/' | relative_url }}"
     style="padding: 0.5rem 1.25rem; border-radius: 25px; text-decoration: none; font-size: 0.95rem; font-weight: 500; transition: all 0.2s ease;
     {% if page.permalink == '/publications/' %}background-color: var(--global-theme-color); color: white; box-shadow: 0 2px 8px rgba(0,0,0,0.15);{% else %}background-color: var(--global-code-bg-color); color: var(--global-text-color);{% endif %}">
    <i class="fas fa-flask" style="margin-right: 0.4rem;"></i>Research Articles
  </a>
  <a href="{{ '/preprints/' | relative_url }}"
     style="padding: 0.5rem 1.25rem; border-radius: 25px; text-decoration: none; font-size: 0.95rem; font-weight: 500; transition: all 0.2s ease;
     {% if page.permalink == '/preprints/' %}background-color: var(--global-theme-color); color: white; box-shadow: 0 2px 8px rgba(0,0,0,0.15);{% else %}background-color: var(--global-code-bg-color); color: var(--global-text-color);{% endif %}">
    <i class="fas fa-file-alt" style="margin-right: 0.4rem;"></i>Preprints
  </a>
  <a href="{{ '/reviews/' | relative_url }}"
     style="padding: 0.5rem 1.25rem; border-radius: 25px; text-decoration: none; font-size: 0.95rem; font-weight: 500; transition: all 0.2s ease;
     {% if page.permalink == '/reviews/' %}background-color: var(--global-theme-color); color: white; box-shadow: 0 2px 8px rgba(0,0,0,0.15);{% else %}background-color: var(--global-code-bg-color); color: var(--global-text-color);{% endif %}">
    <i class="fas fa-comments" style="margin-right: 0.4rem;"></i>Reviews & Commentaries
  </a>
  <a href="{{ '/protocols/' | relative_url }}"
     style="padding: 0.5rem 1.25rem; border-radius: 25px; text-decoration: none; font-size: 0.95rem; font-weight: 500; transition: all 0.2s ease;
     {% if page.permalink == '/protocols/' %}background-color: var(--global-theme-color); color: white; box-shadow: 0 2px 8px rgba(0,0,0,0.15);{% else %}background-color: var(--global-code-bg-color); color: var(--global-text-color);{% endif %}">
    <i class="fas fa-vial" style="margin-right: 0.4rem;"></i>Protocols
  </a>
</div>
